# Production settings for the Docker deployment.
#
# Copy to `.env` beside docker-compose.yml on the server and fill it in. It is
# read twice: once by Docker Compose to build the configuration, and once by
# the app container itself. Never commit the filled-in copy.
#
# Generate every secret below with:
#   openssl rand -hex 32
# Hex only. A password with / or @ or : in it breaks the database URL that
# docker-compose.yml builds from these parts.

# ------------------------------------------------------------------- image
# Built and pushed by .github/workflows/docker.yml. Pin a commit tag here
# (ghcr.io/raselmridha792/deanslist:sha-abc1234) to roll back to it.
APP_IMAGE=ghcr.io/raselmridha792/deanslist:latest

# ------------------------------------------------------------------ domain
# Both names, comma separated. Caddy fetches a certificate for each.
# For a test before DNS points at this server, use :80 and browse by IP.
SITE_ADDRESS=deanslist.live, www.deanslist.live
# Let's Encrypt writes here if a certificate is about to expire unrenewed.
ACME_EMAIL=producer@deanslist.live

# ---------------------------------------------------------------- database
POSTGRES_DB=deanslist
POSTGRES_USER=deanslist
POSTGRES_PASSWORD=

# --------------------------------------------------------------------- app
# 32+ characters. The app refuses to start without it, on purpose: without it
# an admin session cookie could be forged by anyone who has read the code.
AUTH_SECRET=

# The password the FIRST admin account gets when the database is seeded. Set it
# before seeding, so the one in the repository is never valid on this server.
SEED_ADMIN_PASSWORD=

# The public origin. The copy used in the JavaScript bundle is baked in when the
# image is built; this is the copy the server reads at runtime. Keep them equal.
NEXT_PUBLIC_SITE_URL=https://deanslist.live

# Leave both empty. The site's photos and clips are served from the image on
# this server, not from a CDN, so there is no media account to maintain. Baked
# in at build time; read here only if this server builds its own image.
NEXT_PUBLIC_MEDIA_IMAGE_BASE=
NEXT_PUBLIC_MEDIA_VIDEO_BASE=

# Switches on the scheduler container. Without it, scheduled campaigns and show
# reminders queue up and never send.
CRON_SECRET=

# ------------------------------------------------ features, all optional
# Each switches one thing on; the dashboard says plainly which are missing.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
MAIL_FROM=Dean's List <noreply@deanslist.live>
# New-lead notifications: talent to the producer, sponsorship to the CEO.
TEAM_NOTIFY_EMAIL=producer@deanslist.live
BUSINESS_NOTIFY_EMAIL=ceo@deanslist.live
ANTHROPIC_API_KEY=
CHAT_DAILY_TOKEN_CAP=2000000

# Dashboard uploads are written to the `uploads` volume on this server and
# served by Caddy, so no storage account or key is needed.
