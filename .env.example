# Copy to .env and fill in. Validated at boot by src/lib/env.ts — the app refuses
# to start in production if anything required here is missing or still a placeholder.

# ---- Database (PostgreSQL) ---- REQUIRED
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/deanslist?schema=public"

# ---- Auth (admin dashboard) ---- REQUIRED IN PRODUCTION
# Must be 32+ characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# There is no fallback value in production. A shared default would let anyone with
# access to this repository forge an admin session.
AUTH_SECRET=""

# ---- Site ----
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---- Media hosting (optional) ----
# Empty: images and video are served from /public by the app server.
#
# To move them to a CDN, set the two bases below. They are separate because
# Cloudinary splits image and video into different delivery paths; on R2 or any
# plain static host, set both to the same bucket URL.
#
#   Cloudinary:  https://res.cloudinary.com/<cloud_name>/image/upload/deanslist
#                https://res.cloudinary.com/<cloud_name>/video/upload/deanslist
#   R2:          https://media.deanslist.live   (both)
#
# Never point these at deanslist.live: the old site goes away at DNS cutover and
# 12 of its 17 videos are QuickTime that browsers cannot play.
NEXT_PUBLIC_MEDIA_IMAGE_BASE=""
NEXT_PUBLIC_MEDIA_VIDEO_BASE=""

# Upload credentials for scripts/upload-media.mjs. Used only to push files up;
# delivery needs nothing but the public cloud name. NEVER commit the secret —
# this file is the example, .env is the real one and is gitignored.
# Copy from Cloudinary > Settings > API Keys.
CLOUDINARY_URL=""

# ---- Email (Resend) ----
# Optional in development: src/lib/mail.ts logs instead of sending when unset.
# Before ANY bulk campaign send, SPF, DKIM and DMARC must exist on the sending
# domain. deanslist.live currently has no SPF record and DMARC p=none, so campaign
# mail from it would land in spam. Requires DNS access — start this early.
RESEND_API_KEY=""
RESEND_WEBHOOK_SECRET=""
MAIL_FROM="Dean's List <noreply@deanslist.live>"
TEAM_NOTIFY_EMAIL="team@deanslist.live"

# ---- AI chatbot (Phase 8) ----
# Unset means the widget answers from the knowledge base only and never calls a model.
ANTHROPIC_API_KEY=""
# Safety valve on a public, unauthenticated endpoint. Output tokens per day.
CHAT_DAILY_TOKEN_CAP="2000000"

# ---- Scheduled campaigns and reminder sequences (Phase 7.6) ----
# Shared secret for GET /api/cron/tick, called by a systemd timer or PM2 cron.
CRON_SECRET=""

# ---- Object storage for uploads (S3 compatible: R2, Backblaze, Spaces) ----
# Unset means entry forms accept video LINKS only, not file uploads.
# Never store contestant video on the app VPS disk.
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_PUBLIC_URL=""
